# ============================================
# RIEMer Land — Supabase 配置
# ============================================
# 在 Supabase 控制台 (https://supabase.com) 创建项目后：
# 1. 复制本文件为 .env
# 2. 填入项目的 URL 和 Anon Key
# 3. 重启开发服务器
#
# 如果不填写这些值，系统会自动使用 localStorage 本地模式运行
# ============================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
