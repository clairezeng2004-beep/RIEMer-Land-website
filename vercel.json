{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/summarize.js": {
      "maxDuration": 60
    },
    "api/fetch-article.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 8 */3 * *"
    }
  ]
}
